# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Secrets (required in production) ----
GEMINI_API_KEY=
CLIENT_URL=http://localhost:5173
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- AI reliability ----
# Primary Gemini model.
GEMINI_MODEL=gemini-3.6-flash
# Optional fallback model, used only when the primary model is transiently
# unavailable (503) after exhausting its retries. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Extra attempts for the primary model on TRANSIENT errors (503, timeout,
# empty response, temporary rate limit). 0 disables retries.
AI_MAX_RETRIES=2
# Base delay (ms) for exponential backoff between retries (~1s, ~2s, ~4s...).
AI_RETRY_BASE_DELAY_MS=1000
# Hard timeout (ms) for a single Gemini HTTP attempt.
AI_REQUEST_TIMEOUT_MS=120000

# ---- Limits ----
MAX_JOB_DESCRIPTION_LENGTH=20000
MAX_UPLOAD_MB=5
LOG_LEVEL=info

# ---- Analysis quota & cooldown ----
# Guest analyses per IP per UTC day (in-memory).
GUEST_DAILY_ANALYSIS_LIMIT=5
# Analyses per account per UTC day (persisted in MongoDB).
AUTH_DAILY_ANALYSIS_LIMIT=20
# Minimum minutes between two successful analyses (any user).
ANALYSIS_COOLDOWN_MINUTES=10
