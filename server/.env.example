# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Secrets (required in production) ----
GEMINI_API_KEY=
CLIENT_URL=http://localhost:5173
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- AI models ----
# Primary Gemini model.
GEMINI_MODEL=gemini-3.6-flash
# Optional fallback model, used only when the primary model is transiently
# unavailable (503) after exhausting its retries. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ---- Hardcoded application constants (not env-configurable by design) ----
# These values live directly in code and intentionally have NO env override:
#   MAX_JOB_DESCRIPTION_LENGTH = 20000  (server/config/env.js → env.maxJobDescriptionLength)
#   MAX_UPLOAD_MB = 5                   (server/config/env.js → env.maxUploadBytes)
#   LOG_LEVEL = info                    (server/utils/logger.js → configuredLevel)
#   GUEST_DAILY_ANALYSIS_LIMIT = 1      (server/config/env.js → env.guestDailyAnalysisLimit)
#   AUTH_DAILY_ANALYSIS_LIMIT = 2       (server/config/env.js → env.authDailyAnalysisLimit)
#   AI_MAX_RETRIES = 2                  (server/config/env.js → env.aiMaxRetries)
#   AI_RETRY_BASE_DELAY_MS = 1000       (server/config/env.js → env.aiRetryBaseDelayMs)
#   AI_REQUEST_TIMEOUT_MS = 120000      (server/config/env.js → env.aiRequestTimeoutMs)
#   OTP_CODE_LENGTH = 6                 (server/models/User.js → OTP_CODE_LENGTH)
#   OTP_VALIDITY_MINUTES = 10           (server/models/User.js → OTP_TTL_MS)
#   OTP_MAX_ATTEMPTS = 5                (server/models/User.js → OTP_MAX_ATTEMPTS)
# To change any of them, edit the source directly — setting them here has no effect.

# ---- SMTP / Email ----
SMTP_FROM=no-reply@example.com
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
